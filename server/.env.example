# Copy to .env (the dev defaults below work out of the box)
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-secret-change-me"
PORT=4000

# ── Supabase (production Postgres) ──────────────────────────────────────────
# The hosted backend runs against the Supabase project "loopedin"
# (ref sygeaxmjmkwedwkvoopb, Rebel One org). To point the server at it,
# replace DATABASE_URL with the Supabase connection string (Dashboard →
# Connect → Direct connection or Session pooler) and use the *.postgres.prisma
# schema scripts:
#
#   DATABASE_URL="postgresql://postgres:[PASSWORD]@db.sygeaxmjmkwedwkvoopb.supabase.co:5432/postgres"
#   npm run generate:pg && npm run db:push:pg && npm run seed
#
# See docs/supabase-backend.md. NEVER expose this URL to the frontend build —
# the weloopedin.com static deploy stays in offline/demo mode by design.
